{
  "Jwt": {
    "Key": "GymBookingSystemSuperSecretKey2026VeryLongKey12345",
    "Issuer": "GymBookingSystem",
    "Audience": "GymBookingSystemUsers",
    "ExpiryMinutes": 60
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },

      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/Users/{**catch-all}"
        }
      },

      "bookings-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/Bookings/{**catch-all}"
        }
      },

      "classes-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/Classes/{**catch-all}"
        }
      },

      "payments-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/Payments/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-destination": {
            "Address": "http://localhost:5270/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}